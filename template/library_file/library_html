<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign Library – Sign Bridge</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="library.css">
  <link rel="stylesheet" href="chatbot.css">
</head>
<body>

  <!-- ===== HEADER ===== -->
  <header class="site-header">
    <a class="brand" href="index.html" aria-label="Sign Bridge home">
      <span class="brand-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V11m0-6.5v-1a1.5 1.5 0 0 1 3 0V11m0-5a1.5 1.5 0 0 1 3 0v6m0-3.5a1.5 1.5 0 0 1 3 0V15a7 7 0 0 1-7 7h-1.5a6 6 0 0 1-5-2.7L3.5 15.5a1.6 1.6 0 0 1 2.6-1.8L8 16"/></svg>
      </span>
      <span class="brand-name">Sign <b>Bridge</b></span>
    </a>
    <nav class="nav" aria-label="Main">
      <a href="index.html#recognize">Recognize</a>
      <a href="library.html" class="active" aria-current="page">Sign library</a>
      <a href="index.html#about">About</a>
      <a href="index.html#recognize" class="btn btn-outline">Try a demo <span class="arrow">↗</span></a>
    </nav>
  </header>

  <main>
    <!-- ===== TITLE BANNER ===== -->
    <section class="lib-hero">
      <div class="lib-hero-inner">
        <p class="eyebrow">Small signs. Big connections.</p>
        <h1>Sign <span>Library</span></h1>
        <hr class="hero-rule">
        <p class="lead">Browse everyday signs, see how each one is made, and practice them with the camera.</p>
      </div>
    </section>

    <!-- ===== SEARCH + FILTERS ===== -->
    <section class="lib-tools" aria-label="Search and filter">
      <div class="lib-bar">
        <label class="lib-search">
          <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
          <input id="libSearch" type="search" placeholder="Search signs, e.g. hello" autocomplete="off" aria-label="Search signs">
        </label>
        <span class="lib-lang" id="libLang">ASL · English</span>
      </div>
      <div class="lib-filters" id="libFilters" role="group" aria-label="Filter by category"></div>
    </section>

    <!-- ===== GRID ===== -->
    <section class="lib-section">
      <p class="lib-count" id="libCount" aria-live="polite"></p>
      <div class="lib-grid" id="libGrid"></div>

      <div class="lib-none" id="libNone" hidden>
        <h3>No signs found</h3>
        <p>Try a different word or choose another category.</p>
      </div>

      <p class="lib-note">These written steps are simplified guides. To learn a sign properly, watch a fluent signer or learn with a Deaf teacher.</p>
    </section>
  </main>

  <!-- ===== SIGN DETAIL DIALOG ===== -->
  <dialog class="sign-dialog" id="signDialog" aria-labelledby="dlgWord">
    <button class="dlg-close" id="dlgClose" aria-label="Close"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    <div class="dlg-body">
      <div class="dlg-visual" id="dlgMedia"></div>
      <div class="dlg-info">
        <p class="dlg-meta"><span id="dlgNum"></span><span id="dlgCat"></span></p>
        <h2 id="dlgWord"></h2>
        <h3>How to sign it</h3>
        <ol class="dlg-steps" id="dlgSteps"></ol>
        <p class="dlg-tip"><b>Tip</b><span id="dlgTip"></span></p>
        <a class="btn btn-dark dlg-practice" href="index.html#recognize">Practice with the camera <span>→</span></a>
      </div>
    </div>
    <footer class="dlg-nav">
      <button class="dlg-btn" id="dlgPrev"><span>←</span> Previous</button>
      <button class="dlg-btn" id="dlgNext">Next <span>→</span></button>
    </footer>
  </dialog>

  <footer class="site-footer"><p>© <span id="year"></span> Sign Bridge. Made for connection, designed for everyone.</p></footer>

  <!-- ===== CHATBOT (same markup as chatbot.html) ===== -->
  <button class="cb-launcher" id="cbLauncher" aria-label="Open chat" aria-expanded="false" aria-controls="cbPanel">
    <svg viewBox="0 0 24 24"><path d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-8l-5 4v-4H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"/></svg>
  </button>
  <section class="cb-panel" id="cbPanel" role="dialog" aria-label="Sign Bridge assistant" hidden>
    <header class="cb-head">
      <span class="cb-avatar"><svg viewBox="0 0 24 24"><path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V11m0-6.5v-1a1.5 1.5 0 0 1 3 0V11m0-5a1.5 1.5 0 0 1 3 0v6m0-3.5a1.5 1.5 0 0 1 3 0V15a7 7 0 0 1-7 7h-1.5a6 6 0 0 1-5-2.7L3.5 15.5a1.6 1.6 0 0 1 2.6-1.8L8 16"/></svg></span>
      <div class="cb-title"><b>Bridge assistant</b><small><span class="cb-dot"></span>Here to help</small></div>
      <button class="cb-close" id="cbClose" aria-label="Close chat"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </header>
    <div class="cb-log" id="cbLog" role="log" aria-live="polite"></div>
    <div class="cb-chips" id="cbChips"></div>
    <div class="cb-input">
      <input id="cbInput" type="text" placeholder="Ask about signs, camera, privacy…" autocomplete="off" aria-label="Your message">
      <button id="cbSend" aria-label="Send message"><svg viewBox="0 0 24 24"><path d="M4 12l16-8-6 16-3-6z"/></svg></button>
    </div>
  </section>

  <script src="signs-data.js"></script>
  <script src="library.js"></script>
  <script src="chatbot.js"></script>
</body>
</html>